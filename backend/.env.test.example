# Copy to .env.test and fill in. NEVER point TEST_MONGODB_URI at your
# real/dev database — integration tests wipe all collections between runs.

TEST_MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/crypto_simulator_test

JWT_SECRET=test_secret_do_not_use_in_production
JWT_EXPIRES_IN=1h

COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_CACHE_TTL_SECONDS=30

STARTING_VIRTUAL_BALANCE_INR=1000000
