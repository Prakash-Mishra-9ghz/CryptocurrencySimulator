# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins in production, e.g.
# https://your-frontend.vercel.app,https://your-custom-domain.com
# Not used in development (all origins allowed for local convenience).
CORS_ORIGIN=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/crypto_simulator

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Market data
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
MARKET_CACHE_TTL_SECONDS=30

# AI Insights (Groq — free tier, no card, get a key at console.groq.com/keys)
GROQ_API_KEY=
# Groq's free-tier model lineup changes fairly often — verify the current
# name at console.groq.com/docs/models before deploying. See docs/ai-insights.md.
GROQ_MODEL=openai/gpt-oss-20b

# Simulator business rules (approved Phase 0 decisions)
STARTING_VIRTUAL_BALANCE_INR=1000000
